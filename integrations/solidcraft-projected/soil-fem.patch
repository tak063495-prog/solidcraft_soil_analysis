+        .params("ground_path, stages_path: explicitly allowed JSON files, at most 64 KiB together; read bridge-contract-valid inputs without changing a design or running a solver"),
+    CommandSpec::new("analysis.soil.model", "Soil Analysis", crate::soil_fem::model)
+        .icon("settings").noundo().at("SOLID", "INSPECT")
+        .params("Read the saved ground/stages, persistent CAD body bindings, source fingerprints and unresolved/changed-input diagnostics; no solver is run"),
+    CommandSpec::new("analysis.soil.configure", "Save Soil Analysis", crate::soil_fem::configure)
+        .icon("settings")
+        .params("ground, stages, bindings: [{analysis_body, cad_body}], expected_cad_sha256, expected_setup_sha256 (from analysis.soil.model); one atomic undo step; material admissibility requires the external FEM validator"),
+    CommandSpec::new("analysis.soil.snapshot", "Inspect Soil Analysis Snapshot", crate::soil_fem::snapshot)
+        .icon("settings").noundo()
+        .params("Read an immutable input snapshot only when bindings resolve and the CAD revision has been reviewed; never infer materials from CAD appearances"),
+    CommandSpec::new("analysis.soil.export", "Export Soil Analysis", crate::soil_fem::export)
