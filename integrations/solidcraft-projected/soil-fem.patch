+        fn owned_mode(s: &mut Session, directory: PathBuf, cooperative: bool) {
+            let frozen = crate::soil_fem::snapshot(s, &json!({})).unwrap();
+            let input = frozen["input_sha256"].as_str().unwrap().to_string();
+            let view_schema = expected_view_schema(&frozen).unwrap();
+            let mut cmd = Command::new(std::env::current_exe().unwrap());
+            cmd.args(["--exact", "soil_jobs::native::tests::job_child_protocol", "--nocapture"])
