+//! Native FEM result workspace. Scientific quantities and section geometry belong
+//! to L4; this adapter uses the shared GPU pipelines, theme and navigation.
+use crate::{
+    SolveApp,
+    gpu::{Frame, GpuScene, SceneSlot, ViewportCallback},
+    theme::Tokens,
+    ui_kit,
+};
+use egui::{Color32, Sense};
+use serde_json::{Value, json};
+use solidcraft_engine::{
+    geom::Aabb3,
+    render::Camera,
+    soil_results::{DisplacementReference, Quantity, Scene, Section, Settings},
+};
+use std::{
+    hash::{Hash, Hasher},
+    sync::{Arc, Mutex},
+};
+
+pub struct Viewer {
+    saved_camera: Camera,
+    controls: bool,
+    settings: Settings,
+    info: Value,
+    error: Option<String>,
+    query: Option<Value>,
+    query_id: usize,
+    query_material: u32,
+    query_kind: u8,
+    slot: SceneSlot,
+    key: Option<u64>,
+    source_key: Option<String>,
+    revision: u64,
+}
+pub fn active(app: &SolveApp) -> bool {
+    app.soil_result_viewer.is_some()
+}
+pub fn bounds(app: &mut SolveApp) -> Option<Aabb3> {
+    app.session.soil_result_scene().ok().flatten().map(|s| s.bounds).filter(|b| !b.is_empty())
+}
+pub fn open_viewer(app: &mut SolveApp) {
+    let Some(settings) = app.session.soil_result_settings() else {
+        pick(app);
+        return;
+    };
+    if let Some(view) = app.soil_result_viewer.as_mut() {
+        view.controls = true;
+        view.settings = settings;
+        view.info = Value::Null;
+        view.key = None;
+        view.query = None;
+        view.error = None;
+        return;
+    }
+    let info = match app.run("analysis.soil.results.status", json!({})) {
+        Ok(info) => info,
+        Err(error) => {
+            app.set_status(error, true);
+            return;
+        }
+    };
+    app.soil_result_viewer = Some(Viewer {
+        saved_camera: app.cam,
+        controls: true,
+        settings,
+        info,
+        error: None,
+        query: None,
+        query_id: 0,
+        query_material: 1,
+        query_kind: 0,
+        slot: Arc::new(Mutex::new(None)),
+        key: None,
+        source_key: None,
+        revision: app.session.revision,
+    });
+    app.cam = Camera::default();
+    app.cam.fov = if app.perspective_view() { 0.6 } else { 0.0 };
+    app.cancel_view_animation();
+    if let Some(bounds) = bounds(app) {
+        app.fit_bounds(bounds);
+    }
+}
+pub fn pick(app: &mut SolveApp) {
+    app.pick_file("Completed soil result manifest", &["json"], |app, path| {
+        let Some(path) = path else {
+            return;
+        };
+        let result = (|| -> Result<(), String> {
+            let snapshot = app.run("analysis.soil.snapshot", json!({}))?;
+            app.run("analysis.soil.results.open", json!({"manifest":path,"expected_input_sha256":snapshot.get("input_sha256")}))?;
+            if let Some(mut settings) = app.session.soil_result_settings() {
+                let info = app.run("analysis.soil.results.status", json!({}))?;
+                settings.frame = info.get("frames").and_then(Value::as_array).map_or(0, |a| a.len().saturating_sub(1));
+                app.run("analysis.soil.results.configure", serde_json::to_value(settings).map_err(|e| e.to_string())?)?;
+            }
+            open_viewer(app);
+            Ok(())
+        })();
+        if let Err(error) = result {
+            app.set_status(error, true);
+        }
+    });
+}
+fn ramp(t: f64) -> Color32 {
+    Tokens::get().analysis_scalar_color(t)
+}
+fn gpu(scene: &Scene, settings: &Settings) -> Result<GpuScene, String> {
+    const MAX_BYTES: usize = 192 << 20;
+    let triangle_bytes = scene.triangles.len().checked_mul(3 * crate::gpu::TRI_SIZE).ok_or("display GPU size overflow")?;
+    let line_count = if settings.wireframe { scene.triangles.len().saturating_mul(3) } else { 0 };
+    let line_bytes = line_count.saturating_add(scene.glyphs.len()).saturating_mul(crate::gpu::LINE_SIZE);
+    if triangle_bytes.saturating_add(line_bytes) > MAX_BYTES {
+        return Err("FEM display exceeds the 192 MiB GPU budget; reduce refinement or disable edges".into());
+    }
+    let mut out = GpuScene::default();
+    out.tris.try_reserve(triangle_bytes).map_err(|_| "FEM GPU vertex allocation failed")?;
+    let [low, high] = scene.color_range;
+    let unavailable = Tokens::get().text_dim;
+    for triangle in &scene.triangles {
+        for vertex in triangle.vertices {
+            let color = vertex.scalar.map_or(unavailable, |v| ramp((v - low) / (high - low)));
+            out.tri(vertex.position_mm.to_f32(), [0.; 3], color.to_array());
+        }
+        if settings.wireframe {
+            for (a, b) in [(0, 1), (1, 2), (2, 0)] {
+                out.line(
+                    triangle.vertices[a].position_mm.to_f32(),
+                    triangle.vertices[b].position_mm.to_f32(),
+                    Tokens::get().body_edge.to_array(),
+                    0.6,
+                    false,
+                );
+            }
+        }
+    }
+    for glyph in &scene.glyphs {
+        out.line(glyph.a_mm.to_f32(), glyph.b_mm.to_f32(), Tokens::get().text.to_array(), 1.4, false);
+    }
+    Ok(out)
+}
+fn legend(ui: &egui::Ui, rect: egui::Rect, scene: &Scene, settings: &Settings) {
+    let t = Tokens::get();
+    let width = 200.;
+    let height = t.space_12;
+    let left = rect.right() - width - t.space_24;
+    let top = rect.bottom() - height - 3. * t.space_24;
+    let painter = ui.painter();
+    for i in 0..64 {
+        let x = left + width * i as f32 / 64.;
+        painter.rect_filled(egui::Rect::from_min_size(egui::pos2(x, top), egui::vec2(width / 64. + 0.5, height)), 0., ramp(f64::from(i) / 63.));
+    }
+    for (value, x, align) in [
+        (scene.color_range[0], left, egui::Align2::LEFT_TOP),
+        ((scene.color_range[0] + scene.color_range[1]) * 0.5, left + width * 0.5, egui::Align2::CENTER_TOP),
+        (scene.color_range[1], left + width, egui::Align2::RIGHT_TOP),
+    ] {
+        painter.text(egui::pos2(x, top + height + t.space_4), align, format!("{value:.4e}"), egui::FontId::proportional(t.font_small), t.text);
+    }
+    painter.text(
+        egui::pos2(left + width, top + height + t.space_24),
+        egui::Align2::RIGHT_TOP,
+        format!("{} ({})", quantity_label(&settings.quantity), settings.quantity.unit()),
+        egui::FontId::proportional(t.font_body),
+        t.text,
+    );
+}
+pub fn show_workspace(app: &mut SolveApp, ui: &mut egui::Ui) {
+    if app.soil_result_viewer.is_none() {
+        return;
+    }
+    let rect = ui.max_rect();
+    app.cam.fov = if app.perspective_view() { 0.6 } else { 0.0 };
+    app.viewport.rect = Some(rect);
+    crate::viewport::refresh_layout(app, ui.ctx().pixels_per_point());
+    let response = ui.interact(rect, ui.id().with("soil_results_canvas"), Sense::click_and_drag());
+    crate::navigation::handle(app, ui, rect, &response, crate::navigation::NavCaps::RENDER);
+    let Some(mut viewer) = app.soil_result_viewer.take() else {
+        return;
+    };
+    ui.painter().rect_filled(rect, 0., Tokens::get().viewport_top);
+    let result = (|| -> Result<(), String> {
+        let scene = app.session.soil_result_scene().map_err(|e| e.to_string())?.ok_or("No soil results are loaded")?;
+        if scene.triangles.is_empty() {
+            return Err("The reference section has no visible intersection on its retained side".into());
+        }
+        if app.viewport.gpu.is_none() {
+            return Err("A GPU viewport is required for this FEM result view".into());
+        }
+        let settings = app.session.soil_result_settings().ok_or("No soil result settings")?;
+        let mut hash = std::collections::hash_map::DefaultHasher::new();
+        "soil-results".hash(&mut hash);
+        scene.key.hash(&mut hash);
+        for color in Tokens::get().analysis.curvature {
+            for component in color {
+                component.to_bits().hash(&mut hash);
+            }
+        }
+        for color in [Tokens::get().text_dim, Tokens::get().body_edge, Tokens::get().text] {
+            color.to_array().hash(&mut hash);
+        }
+        let key = hash.finish();
+        if viewer.key != Some(key) {
+            let data = gpu(&scene, &settings)?;
+            let mut slot = viewer.slot.lock().map_err(|_| "FEM scene upload lock is unavailable")?;
+            *slot = Some(data);
+            viewer.key = Some(key);
+        }
+        let ppp = ui.ctx().pixels_per_point();
+        let mut camera = app.cam;
+        camera.fov = if app.perspective_view() { 0.6 } else { 0.0 };
+        let radius = scene.bounds.diagonal().max(10.) + scene.bounds.center().dist(camera.target);
+        let eye = camera.eye();
+        let slot = viewer.slot.clone();
+        ui.painter().add(egui_wgpu::Callback::new_paint_callback(
+            rect,
+            ViewportCallback(Frame {
+                product: true,
+                key,
+                slot: slot.clone(),
+                sketch_key: 0,
+                sketch_slot: slot.clone(),
+                hl_key: 0,
+                hl_slot: slot.clone(),
+                pv_key: 0,
+                pv_slot: slot,
+                pv_hide: false,
+                view_proj: camera.view_proj(f64::from(rect.width() / rect.height().max(1.)), radius).to_f32(),
+                back: camera.back().to_f32(),
+                size_px: [rect.width() * ppp, rect.height() * ppp],
+                clip: [0.; 4],
+                cap: [0.; 4],
+                images: Vec::new(),
+                analysis: [0.; 8],
+                analysis_colors: [0.; 36],
+                access: None,
+                outline: false,
+                eye: [eye.x as f32, eye.y as f32, eye.z as f32, if camera.fov > 0. { 1. } else { 0. }],
+                ao_radius: 0.,
+                ssaa: 1.,
+            }),
+        ));
+        legend(ui, crate::shell::workspace_content(app, rect), &scene, &settings);
+        if response.clicked()
+            && let Some(point) = response.interact_pointer_pos()
+        {
+            let (origin, direction) = crate::viewport::projection(app, rect).ray(point);
+            match app.run("analysis.soil.results.query", json!({"ray_origin_mm":origin,"ray_direction":direction})) {
+                Ok(value) => {
+                    viewer.query = Some(value);
+                    viewer.controls = true;
+                }
+                Err(error) => viewer.error = Some(error),
+            }
+        }
+        Ok(())
+    })();
+    if let Err(error) = result {
+        ui.painter().text(
+            rect.center(),
+            egui::Align2::CENTER_CENTER,
+            error,
+            egui::FontId::proportional(Tokens::get().font_heading),
+            Tokens::get().form_error,
+        );
+    }
+    crate::viewport::axis_view(app, ui, rect);
+    app.soil_result_viewer = Some(viewer);
+}
