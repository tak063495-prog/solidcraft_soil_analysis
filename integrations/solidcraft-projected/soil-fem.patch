+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn fixture(quadratic: bool, curved: bool) -> (Geometry, Frame) {
+        let mut nodes = vec![[0., 0., 0.], [1., 0., 0.], [0., 1., 0.], [0., 0., 1.]];
+        if quadratic {
+            for [a, b] in EDGES {
+                let p = (Vec3::from(nodes[a]) + Vec3::from(nodes[b])) * 0.5;
+                nodes.push(p.into());
+            }
+            if curved {
+                nodes[4][2] = 0.2;
+            }
+        }
+        let count = nodes.len();
+        let cell: Vec<_> = (0..count).collect();
+        let mut faces = Vec::new();
+        for corners in FACES {
+            let mut face = corners.to_vec();
+            if quadratic {
+                for [a, b] in [[corners[0], corners[1]], [corners[1], corners[2]], [corners[2], corners[0]]] {
+                    face.push(4 + EDGES.iter().position(|e| e.contains(&a) && e.contains(&b)).unwrap());
+                }
+            }
+            faces.push(json!({"element_index":0,"nodes":face}));
+        }
+        let vectors: Vec<_> = nodes.iter().map(|p| [0., 0., 0.001 * p[0] * p[0]]).collect();
+        let g=serde_json::from_value(json!({"schema":"soil-fem-view-geometry/1","length_unit":"m","axis":"Z-up","nodes_m":nodes,"cells":[cell],"cell_kind":if quadratic{"tetra10"}else{"tetra4"},"regions":[],"node_sets":{},"crs":"LOCAL","origin_m":[0,0,0]})).unwrap();
+        let f=serde_json::from_value(json!({"schema":"soil-fem-view-frame/1","index":0,"name":"test","active_element_ids":[0],"active_node_ids":(0..count).collect::<Vec<_>>(),"boundary_faces":faces,
+            "node_fields":{"displacement_m":vectors,"stage_displacement_increment_m":vectors,"total_displacement_from_seed_m":vectors,"display_reference_displacement_m":vec![[0.;3];count]},
+            "cell_fields":{"effective_stress_compression_positive_kpa":[[3.,2.,1.,0.,0.,0.]],"plastic_strain_compression_positive":vec![[0.;6]],"void_ratio":[0.8],"preconsolidation_pressure_kpa":[123.],"material_id":[1],"region_id":[1],"material_model":[0]},
+            "monitors":{},"relative_force_residual":0.,"maximum_normalized_yield":0.})).unwrap();
+        (g, f)
+    }
+    #[test]
+    fn quadratic_boundary_preserves_surface_area_and_cell_constant_values() {
+        let (g, f) = fixture(true, false);
+        check_boundary(&g, &f).unwrap();
+        for (refinement, triangles) in [(1, 16), (2, 64), (3, 256)] {
+            let settings = Settings { quantity: Quantity::PreconsolidationPressure, refinement, deformation_scale: 0., ..Default::default() };
+            let scene = build(&g, &f, &settings, "synthetic").unwrap();
+            assert_eq!(scene.triangles.len(), triangles);
+            let area: f64 = scene
+                .triangles
+                .iter()
+                .map(|t| {
+                    let [a, b, c] = t.vertices.map(|v| v.position_mm);
+                    (b - a).cross(c - a).len() * 0.5e-6
+                })
+                .sum();
+            assert!((area - (1.5 + 3.0f64.sqrt() * 0.5)).abs() < 1e-12);
+            assert!(scene.triangles.iter().flat_map(|t| t.vertices).all(|v| v.scalar == Some(123.)));
+        }
+    }
+    #[test]
+    fn refined_curved_section_converges_to_independent_area_and_quadratic_field() {
+        let (g, f) = fixture(true, true);
+        let mut settings = Settings {
+            deformation_scale: 0.,
+            section: Some(Section { normal: [1., 0., 0.], offset_m: 0.25, slice_only: true }),
+            ..Default::default()
+        };
+        let coarse = build(&g, &f, &settings, "coarse").unwrap();
+        assert!((coarse.reference_section_area_m2 - 0.24375).abs() < 1e-12);
+        for refinement in [2, 3] {
+            settings.refinement = refinement;
+            let scene = build(&g, &f, &settings, "fine").unwrap();
+            // z=t+0.8*r*(1-r-s-t); at r=1/4 this is affine in s,t.
+            // The triangle has y extent 3/4 and z extent 3/4-3/20.
+            assert!((scene.reference_section_area_m2 - 0.225).abs() < 1e-12);
+            assert!(scene.triangles.iter().all(|t| t.section));
+            let values: Vec<_> = scene.triangles.iter().flat_map(|t| t.vertices).map(|v| v.scalar.unwrap()).collect();
+            assert!(values.iter().all(|v| (*v - 0.0625).abs() < 1e-12), "refinement {refinement}: {values:?}");
+        }
+    }
+    #[test]
+    fn section_on_subdivision_faces_is_not_double_counted_and_warp_follows_reference_cut() {
+        let (g, f) = fixture(true, false);
+        for refinement in [1, 2, 3] {
+            let settings = Settings {
+                refinement,
+                deformation_scale: 100.,
+                principal_directions: true,
+                section: Some(Section { normal: [2., 0., 0.], offset_m: 1., slice_only: true }),
+                ..Default::default()
+            };
+            let scene = build(&g, &f, &settings, "cut").unwrap();
+            assert!((scene.reference_section_area_m2 - 0.125).abs() < 1e-12);
+            assert!(scene.triangles.iter().flat_map(|t| t.vertices).all(|v| v.position_mm.x.abs() < 1e-10));
+            assert_eq!(scene.glyphs.len(), 1);
+            let anchor = (scene.glyphs[0].a_mm + scene.glyphs[0].b_mm) / 2000. + scene.render_origin_m;
+            assert!((anchor.x - 0.5).abs() < 1e-12);
+            assert!((anchor.y - 1. / 6.).abs() < 1e-12);
+            assert!((anchor.z - (1. / 6. + 0.025)).abs() < 1e-12);
+            let face = Settings {
+                refinement,
+                deformation_scale: 0.,
+                section: Some(Section { normal: [-1., 0., 0.], offset_m: 0., slice_only: true }),
+                ..Default::default()
+            };
+            let face_scene = build(&g, &f, &face, "coplanar face").unwrap();
+            assert!((face_scene.reference_section_area_m2 - 0.5).abs() < 1e-12);
+        }
+        let outside = Settings {
+            principal_directions: true,
+            section: Some(Section { normal: [1., 0., 0.], offset_m: 2., slice_only: true }),
+            ..Default::default()
+        };
+        let empty = build(&g, &f, &outside, "outside slice").unwrap();
+        assert!(empty.triangles.is_empty());
+        assert!(empty.glyphs.is_empty(), "a cell wholly on the retained side still has no slice intersection");
+    }
+    #[test]
+    fn mean_tensor_axes_rotate_and_repeated_major_directions_are_not_invented() {
+        let p = principal([3., 3., 1., 1., 0., 0.]);
+        assert!((p.values[0] - 4.).abs() < 1e-12);
+        assert!((p.values[1] - 2.).abs() < 1e-12);
+        assert!((p.values[2] - 1.).abs() < 1e-12);
+        let axis = p.axis.unwrap();
+        let expected = Vec3::new(1., 1., 0.).normalized().unwrap();
+        assert!((axis.dot(expected).abs() - 1.).abs() < 1e-12);
+        assert!(principal([4., 4., 1., 0., 0., 0.]).axis.is_none());
+        assert!(principal([3., 3., 3., 0., 0., 0.]).axis.is_none());
+    }
+    #[test]
+    fn ray_queries_retain_original_element_and_world_display_position() {
+        let (g, f) = fixture(true, false);
+        let settings = Settings { quantity: Quantity::PreconsolidationPressure, deformation_scale: 0., ..Default::default() };
+        let scene = build(&g, &f, &settings, "ray").unwrap();
+        let hit = pick(&scene, Vec3::new(-400., -400., 2000.), -Vec3::Z);
+        assert_eq!(hit["element"], 0);
+        assert_eq!(hit["value"], 123.);
+        assert!((hit["display_position_m"][2].as_f64().unwrap() - 0.8).abs() < 1e-12);
+    }
+    #[test]
+    fn unavailable_values_are_not_zero_and_bad_connectivity_is_an_error() {
+        let (mut g, mut f) = fixture(false, false);
+        f.cell_fields.preconsolidation_pressure_kpa = vec![None];
+        let settings = Settings { quantity: Quantity::PreconsolidationPressure, ..Default::default() };
+        assert!(build(&g, &f, &settings, "null").is_err());
+        g.cells[0][0] = usize::MAX;
+        assert!(build(&g, &f, &Settings::default(), "bad").is_err());
+    }
+}
