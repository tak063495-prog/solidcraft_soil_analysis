+        for glyph in &scene.glyphs {
+            let anchor = (glyph.a_mm + glyph.b_mm) / 2000. + scene.render_origin_m;
+            assert!((anchor.x - 5.).abs() < 1e-10, "slice axes must be anchored on the cut plane");
+        }
+        let mut area = 0.;
+        let mut first_moment = Vec3::ZERO;
+        for t in &scene.triangles {
+            assert!(t.section);
+            let points = t.vertices.map(|v| v.position_mm / 1000. + scene.render_origin_m);
+            let [a, b, c] = points;
+            assert!(points.iter().all(|p| (p.x - 5.).abs() < 1e-11));
+            let weight = (b - a).cross(c - a).len() * 0.5;
+            area += weight;
+            first_moment += (a + b + c) * (weight / 3.);
+        }
+        let center = first_moment / area;
+        // Full section is 10*8, less the 4*2 excavation centered at y=5,z=7.
+        assert!((area - 72.).abs() < 1e-9, "area={area}");
+        assert!((center.y - 5.).abs() < 1e-10);
+        assert!((center.z - 11. / 3.).abs() < 1e-10);
+        assert!((scene.reference_section_area_m2 - area).abs() < 1e-10);
+        observations.push(json!({"refinement":refinement,"reference_area_m2":area,"centroid_m":center,"status":status}));
+    }
+    let loaded = s.soil_results.loaded.as_ref().unwrap().clone();
+    let node = loaded.frame.active_node_ids[0];
+    let element = loaded.frame.active_element_ids[0];
+    let point = loaded.layout.iter().position(|p| p.element_index == element).unwrap();
+    let node_query = s.execute("analysis.soil.results.query", &json!({"node":node})).unwrap();
+    let point_query = s.execute("analysis.soil.results.query", &json!({"integration_point":point})).unwrap();
+    let mean_query = s.execute("analysis.soil.results.query", &json!({"element":element})).unwrap();
+    assert_eq!(point_query["element"], element);
+    assert_eq!(point_query["frame_name"], "excavate_pit");
+    assert_eq!(node_query["input_sha256"], input);
+    assert_eq!(s.doc.to_json(), original);
+    assert_eq!(s.undo.len(), undo);
+    let report = json!({"schema":"soil-fem-native-result-reader-acceptance/1","passed":true,"actual_completed_native_job":true,
+        "input_sha256":input,"manifest_sha256":loaded.manifest_sha,"sections":observations,"node_query":node_query,
+        "element_query":mean_query,"integration_point_query":point_query,"design_and_undo_unchanged":true,
+        "scope":"Engine result loading and section/raw-value verification only; no GPU or GUI claim"});
+    let report_path = PathBuf::from(std::env::var("SOIL_RESULT_ACCEPTANCE_REPORT").unwrap());
+    let mut file = std::fs::OpenOptions::new().write(true).create_new(true).open(report_path).unwrap();
+    use std::io::Write;
+    file.write_all(&serde_json::to_vec_pretty(&report).unwrap()).unwrap();
+}
