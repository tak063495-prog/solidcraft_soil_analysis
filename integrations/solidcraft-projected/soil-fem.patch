+use super::geometry;
+use crate::{
+    Result, Session,
+    geom::{Aabb3, Vec3},
+    params::bad,
+};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    path::{Component, Path, PathBuf},
+    sync::Arc,
+};
+
+const CMD: &str = "analysis.soil.results";
+const MAX_FILE: usize = 256 << 20;
+const MAX_TOTAL: u64 = 512 << 20;
+const MAX_NODES: usize = 1_000_000;
+const MAX_CELLS: usize = 300_000;
+
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum Quantity {
+    VerticalDisplacement,
+    DisplacementMagnitude,
+    EffectiveStressZz,
+    MeanEffectiveStress,
+    MajorEffectiveStress,
+    PrimaryMeanEffectiveStress,
+    WorkEffectiveStressZz,
+    MaterialVolumeStrain,
+    KinematicVolumeStrain,
+    VoidRatio,
+    PreconsolidationPressure,
+    VolumetricPlasticStrain,
+}
+impl Quantity {
+    pub fn unit(&self) -> &'static str {
+        match self {
+            Self::VerticalDisplacement | Self::DisplacementMagnitude => "mm",
+            Self::VoidRatio | Self::VolumetricPlasticStrain | Self::MaterialVolumeStrain | Self::KinematicVolumeStrain => "1",
+            _ => "kPa",
+        }
+    }
+    pub fn nodal(&self) -> bool {
+        matches!(self, Self::VerticalDisplacement | Self::DisplacementMagnitude)
+    }
+    pub fn primary(&self) -> bool {
+        matches!(self, Self::PrimaryMeanEffectiveStress | Self::MaterialVolumeStrain)
+    }
+}
