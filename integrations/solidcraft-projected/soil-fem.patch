+                if let Some(range)=viewer.settings.color_range.as_mut() {
+                    ui_kit::row(ui,"Legend limits",|ui|{for limit in range {changed|=ui_kit::number_field(ui,limit,f64::MIN..=f64::MAX,0.1,"").changed();}});
