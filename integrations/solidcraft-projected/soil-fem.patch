+
+        fn write(path: &Path, value: &Value) {
+            std::fs::write(path, serde_json::to_vec(value).unwrap()).unwrap();
+        }
+
+        fn receipt(s: &Session) {
+            let j = s.soil_jobs.job.as_ref().unwrap();
+            let folder = j.directory.join("job");
+            write(
+                &folder.join("job.json"),
+                &json!({"schema":"soil-fem-native-job/1","job_id":"worker-owned","host_token":j.token,"input_sha256":j.input,"solver_sha256":"a".repeat(64)}),
+            );
+            write(
+                &folder.join("workflow/view/view-manifest.json"),
+                &json!({"schema":j.view_schema,"complete":true,"input_sha256":j.input,"solver_binary_sha256":"a".repeat(64)}),
+            );
+            let manifest = hash(&folder.join("workflow/view/view-manifest.json")).unwrap();
+            write(&folder.join("workflow/view-verification.json"), &json!({"passed":true,"input_sha256":j.input,"view_manifest_sha256":manifest}));
+            write(
+                &folder.join("status.json"),
+                &json!({"schema":"soil-fem-native-job-status/1","job_id":"worker-owned","input_sha256":j.input,
+                "host_token":j.token,"worker_pid":j.child.id()+1,"state":"succeeded","result":"workflow/view/view-manifest.json","result_sha256":manifest,
+                "view_audit_sha256":hash(&folder.join("workflow/view-verification.json")).unwrap()}),
+            );
+        }
+
+        fn finish(s: &mut Session) {
+            let j = s.soil_jobs.job.as_mut().unwrap();
+            j.child.stdin.take();
+            let deadline = Instant::now() + Duration::from_secs(10);
+            while j.child.try_wait().unwrap().is_none() && Instant::now() < deadline {
+                std::thread::sleep(Duration::from_millis(20));
+            }
+            assert!(j.child.try_wait().unwrap().is_some(), "owned test child must finish after pipe closure");
+        }
