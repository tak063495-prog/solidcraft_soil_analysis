+                });});
+                ui_kit::row(ui,"Displacement basis",|ui|{ui_kit::dropdown_menu(ui,"soil_result_reference",crate::i18n::tr_label(match viewer.settings.displacement_reference {DisplacementReference::Display=>"Display reference",DisplacementReference::Stage=>"Stage increment",DisplacementReference::Seed=>"Total from seed"}),|ui| {
+                    for (basis,label) in [(DisplacementReference::Display,"Display reference"),(DisplacementReference::Stage,"Stage increment"),(DisplacementReference::Seed,"Total from seed")] {changed|=choose(ui,&mut viewer.settings.displacement_reference,basis,label);}
+                });});
+                ui_kit::row(ui,"Deformation scale",|ui|{changed|=ui_kit::number_field(ui,&mut viewer.settings.deformation_scale,0.0..=1e6,1.,"").changed();});
+                ui_kit::row(ui,"Display refinement",|ui|{for level in 1..=3 {changed|=choose(ui,&mut viewer.settings.refinement,level,format!("{}",1u32<<level));}});
+                let mut manual_range=viewer.settings.color_range.is_some();
+                if ui_kit::checkbox(ui,crate::i18n::tr_label("Fixed legend range"),&mut manual_range).changed() {
+                    viewer.settings.color_range=manual_range.then(|| viewer.info.get("color_range").and_then(Value::as_array).and_then(|a| Some([a.first()?.as_f64()?,a.get(1)?.as_f64()?])).unwrap_or([-1.,1.]));
+                    changed=true;
