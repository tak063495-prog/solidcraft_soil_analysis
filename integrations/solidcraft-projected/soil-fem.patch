+                    changed|=ui_kit::checkbox(ui,crate::i18n::tr_label("Section only (off: keep negative side)"),&mut section.slice_only).changed();
+                }
+                changed|=ui_kit::checkbox(ui,crate::i18n::tr_label("Display triangle edges"),&mut viewer.settings.wireframe).changed();
+                changed|=ui_kit::checkbox(ui,crate::i18n::tr_label("Major axis of mean effective tensor"),&mut viewer.settings.principal_directions).changed();
+            });
+            if let Some(range)=viewer.info.get("data_range").and_then(Value::as_array)
+                && let (Some(low),Some(high))=(range.first().and_then(Value::as_f64),range.get(1).and_then(Value::as_f64)) {
+                ui.label(format!("Range: {low:.5e} to {high:.5e} {}",viewer.settings.quantity.unit()));
+            }
+            ui_kit::text(ui,if viewer.settings.quantity.nodal(){"Nodal displacement interpolation. Z is up: settlement negative, heave positive."}else{"Original-cell integration-weighted means. Stress is compression positive; no smoothing to nodes. Null values are unavailable."},ui_kit::Text::Note("soil_result_values"));
+            ui_kit::text(ui,"Curved Tet10 surfaces and sections use refined planar display triangles. Section planes use reference coordinates; deformation is applied afterwards.",ui_kit::Text::Note("soil_result_approximation"));
+            ui.horizontal(|ui| {ui_kit::dropdown_menu(ui,"soil_query_kind",["Node","Element mean","Raw integration point","Primary node + material"].get(viewer.query_kind as usize).copied().unwrap_or("Node"),|ui| {for (kind,label) in [(0,"Node"),(1,"Element mean"),(2,"Raw integration point"),(3,"Primary node + material")] {choose(ui,&mut viewer.query_kind,kind,label);}});
+                ui_kit::number_field(ui,&mut viewer.query_id,0..=usize::MAX,1.,"");
+                if viewer.query_kind==3 {ui.label("Material");ui_kit::number_field(ui,&mut viewer.query_material,1..=u32::MAX,1.,"");}
+                inspect=ui_kit::button(ui,"Read stored value",ui_kit::Button::Enabled(!stale)).clicked();});
+            if let Some(value)=&viewer.query {ui_kit::section(ui,"soil_selected_value","Selected value",true,|ui| {ui.add(egui::Label::new(serde_json::to_string_pretty(value).unwrap_or_default()).wrap());});}
+            if let Some(error)=&viewer.error {ui_kit::text(ui,error,ui_kit::Text::Report("soil_result_error",true));}
+            ui_kit::text(ui,"Close this header to hide controls; Soil Result Viewer reopens them. Return to CAD releases this result.",ui_kit::Text::Note("soil_result_close"));
+        });
+    if hidden {
+        viewer.controls = false;
+    }
+    if action == ui_kit::Action::Cancel {
+        let _ = app.run("analysis.soil.results.close", json!({}));
+        app.cam = viewer.saved_camera;
+        app.cancel_view_animation();
+        return;
+    }
+    if changed {
+        match serde_json::to_value(&viewer.settings).map_err(|e| e.to_string()).and_then(|p| app.run("analysis.soil.results.configure", p)) {
+            Ok(info) => {
+                viewer.info = info;
+                viewer.error = None;
+                viewer.query = None;
+            }
+            Err(error) => {
+                viewer.error = Some(error);
+                if let Some(settings) = app.session.soil_result_settings() {
+                    viewer.settings = settings;
+                }
+            }
+        }
+    }
+    if inspect {
+        let params = match viewer.query_kind {
+            0 => json!({"node":viewer.query_id}),
+            1 => json!({"element":viewer.query_id}),
+            3 => json!({"primary_node":viewer.query_id,"primary_material":viewer.query_material}),
+            _ => json!({"integration_point":viewer.query_id}),
+        };
+        match app.run("analysis.soil.results.query", params) {
+            Ok(value) => {
+                viewer.query = Some(value);
+                viewer.error = None;
+            }
+            Err(error) => viewer.error = Some(error),
+        }
+    }
+    app.soil_result_viewer = Some(viewer);
+    if fit {
+        app.animate_fit_all();
+    }
+    if load {
+        pick(app);
+    }
+}
+
+fn quantity_label(quantity: &Quantity) -> &'static str {
+    match quantity {
+        Quantity::VerticalDisplacement => "Vertical displacement",
+        Quantity::DisplacementMagnitude => "Displacement magnitude",
+        Quantity::EffectiveStressZz => "Material effective stress zz",
+        Quantity::MeanEffectiveStress => "Material mean effective stress p",
+        Quantity::MajorEffectiveStress => "Major material effective stress",
+        Quantity::PrimaryMeanEffectiveStress => "Primary mean effective stress (P1)",
+        Quantity::WorkEffectiveStressZz => "Work-conjugate effective zz (cell mean)",
+        Quantity::MaterialVolumeStrain => "Material volume strain (P1)",
+        Quantity::KinematicVolumeStrain => "Kinematic volume strain (cell mean)",
+        Quantity::VoidRatio => "Void ratio",
+        Quantity::PreconsolidationPressure => "Preconsolidation pressure pc",
+        Quantity::VolumetricPlasticStrain => "Volumetric plastic strain",
+    }
+}
+
+fn choose<T: PartialEq>(ui: &mut egui::Ui, value: &mut T, next: T, label: impl AsRef<str>) -> bool {
+    let label = label.as_ref();
+    if ui_kit::list_picker(ui, label, crate::i18n::tr_label(label), *value == next).clicked() && *value != next {
+        *value = next;
+        return true;
+    }
+    false
+}
