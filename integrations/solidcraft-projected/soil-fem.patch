+//! Transient, host-owned external FEM jobs. Neither executable paths nor process
+//! ownership are read from a design. Scratch sessions have no execution host.
+use crate::{Result, Session, params::bad};
+use serde::Deserialize;
+use serde_json::{Value, json};
+
+const CMD: &str = "analysis.soil.job";
+
+#[cfg(not(target_arch = "wasm32"))]
+fn expected_view_schema(snapshot: &Value) -> Result<&'static str> {
+    match snapshot.pointer("/snapshot/stages/schema").and_then(Value::as_str) {
+        Some("soil-fem-stages/1") => Ok("soil-fem-solidcraft-view/1"),
+        Some("soil-fem-projected-mcc-stages/1") => Ok("soil-fem-solidcraft-view/2"),
+        _ => Err(bad(CMD, "unsupported captured construction family")),
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Start {
+    directory: String,
+    expected_input_sha256: String,
+    mesh_size_m: f64,
+    element_order: u8,
+    quadrature_order: u8,
+    #[serde(default)]
+    cooperative: bool,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Resume {
+    directory: String,
+    previous_directory: String,
+    expected_input_sha256: String,
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+mod native {
+    use super::*;
+    use sha2::{Digest, Sha256};
+    use std::{
+        fs::OpenOptions,
+        path::{Path, PathBuf},
+        process::{Child, Command, Stdio},
+    };
+
+    fn identity(session_serial: u64) -> Result<String> {
+        use std::sync::atomic::{AtomicU64, Ordering};
+        static NEXT: AtomicU64 = AtomicU64::new(1);
+        let serial = NEXT.try_update(Ordering::Relaxed, Ordering::Relaxed, |n| n.checked_add(1)).map_err(|_| bad(CMD, "job identity exhausted"))?;
+        let time = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_err(|e| bad(CMD, e.to_string()))?;
+        // The process-wide counter distinguishes simultaneous starts in separate
+        // document sessions even when Windows reports the same clock tick.
+        Ok(format!("{}-{}-{session_serial}-{serial}", std::process::id(), time.as_nanos()))
+    }
+
+    #[derive(Clone)]
+    pub(super) struct Host {
+        root: PathBuf,
+        python: PathBuf,
+        worker: PathBuf,
+        solver: Option<PathBuf>,
+    }
+
+    fn external_path(path: &Path) -> Result<PathBuf> {
+        let canonical = path.canonicalize().map_err(|e| bad(CMD, e.to_string()))?;
+        #[cfg(windows)]
+        {
+            // std::fs returns a verbatim path. PowerShell and other external
+            // tools need the normal local-drive spelling, including for script
+            // authorization. Do not alter execution policy or accept UNC roots.
+            let text = canonical.to_str().ok_or_else(|| bad(CMD, "external FEM paths must be Unicode"))?;
+            if let Some(local) = text.strip_prefix(r"\\?\") {
+                if local.as_bytes().first().is_some_and(u8::is_ascii_alphabetic)
+                    && local.as_bytes().get(1) == Some(&b':')
+                    && local.as_bytes().get(2) == Some(&b'\\')
+                {
+                    return Ok(PathBuf::from(local));
+                }
+                return Err(bad(CMD, "external FEM requires a local-drive path"));
+            }
+        }
+        Ok(canonical)
+    }
+
+    impl Host {
+        pub(super) fn new(root: &Path) -> Result<Self> {
+            let root = external_path(root)?;
+            let python = root.join(if cfg!(windows) { ".venv/Scripts/python.exe" } else { ".venv/bin/python" });
+            let worker = root.join("tools/native_job.py");
+            for path in [&python, &worker] {
+                if !path.is_file() {
+                    return Err(bad(CMD, format!("FEM host file is missing: {}", path.display())));
+                }
+            }
+            Ok(Self { root, python, worker, solver: None })
+        }
+    }
+
+    pub(super) struct Owned {
+        pub(super) child: Child,
+        directory: PathBuf,
+        input: String,
+        view_schema: &'static str,
+        token: String,
+        worker_id: Option<String>,
+        cancelled: bool,
+        cooperative: bool,
+    }
+
+    impl Drop for Owned {
+        fn drop(&mut self) {
+            // The worker watches EOF and stops its own PowerShell/solver tree.
+            // No saved PID is ever signalled by the host, including on shutdown.
+            self.child.stdin.take();
+        }
+    }
+
+    pub(super) fn read(path: &Path) -> Result<Value> {
+        let bytes = solidcraft_io::vfs::read(&path.to_string_lossy(), 256 << 10).map_err(|e| bad(CMD, e.to_string()))?;
+        serde_json::from_slice(&bytes).map_err(|e| bad(CMD, e.to_string()))
+    }
+
+    fn hash(path: &Path) -> Result<String> {
+        let bytes = solidcraft_io::vfs::read(&path.to_string_lossy(), 256 << 10).map_err(|e| bad(CMD, e.to_string()))?;
+        Ok(format!("{:x}", Sha256::digest(bytes)))
+    }
+
+    fn artifact_hash(path: &Path, expected_size: u64) -> Result<String> {
+        use std::io::Read;
+        if expected_size > 8 << 30 {
+            return Err(bad(CMD, "checkpoint artifact exceeds its size limit"));
+        }
+        solidcraft_io::vfs::check(&path.to_string_lossy()).map_err(|e| bad(CMD, e.to_string()))?;
+        let mut file = std::fs::File::open(path).map_err(|e| bad(CMD, e.to_string()))?;
+        let mut digest = Sha256::new();
+        let mut total = 0_u64;
+        let mut buffer = [0_u8; 65536];
+        loop {
+            let size = file.read(&mut buffer).map_err(|e| bad(CMD, e.to_string()))?;
+            if size == 0 {
+                break;
+            }
+            total += size as u64;
+            if total > expected_size {
+                return Err(bad(CMD, "checkpoint artifact size changed"));
+            }
+            digest.update(buffer.get(..size).ok_or_else(|| bad(CMD, "invalid checkpoint read size"))?);
+        }
+        if total != expected_size {
+            return Err(bad(CMD, "checkpoint artifact size changed"));
+        }
+        Ok(format!("{:x}", digest.finalize()))
+    }
+
+    pub(super) fn saved_checkpoint(folder: &Path, input: &str, report: &Value) -> Result<()> {
+        let owner = read(&folder.join("job.json"))?;
+        let receipt_path = folder.join("checkpoint-receipt.json");
+        let receipt = read(&receipt_path)?;
+        let solver = owner.get("solver_sha256").and_then(Value::as_str).filter(|s| s.len() == 64 && s.bytes().all(|b| b.is_ascii_hexdigit()));
+        let artifact = match receipt.get("kind").and_then(Value::as_str) {
+            Some("solver_checkpoint") => "workflow/analysis/solver-job/checkpoint.json",
+            Some("completed_solver_result") => "workflow/analysis/stage-results.json",
+            _ => return Err(bad(CMD, "unsupported saved checkpoint kind")),
+        };
+        if owner.get("schema").and_then(Value::as_str) != Some("soil-fem-native-job/2")
+            || report.get("schema").and_then(Value::as_str) != Some("soil-fem-native-job-status/2")
+            || report.get("state").and_then(Value::as_str) != Some("checkpointed")
+            || report.get("exit_code").and_then(Value::as_i64) != Some(3)
+            || solver.is_none()
+            || report.get("resume_available") != Some(&Value::Bool(true))
+            || report.get("checkpoint_receipt").and_then(Value::as_str) != Some("checkpoint-receipt.json")
+            || report.get("checkpoint_receipt_sha256").and_then(Value::as_str) != Some(&hash(&receipt_path)?)
+            || receipt.get("schema").and_then(Value::as_str) != Some("soil-fem-native-checkpoint/1")
+            || owner.get("job_id").and_then(Value::as_str).is_none_or(str::is_empty)
+            || report.get("job_id") != owner.get("job_id")
+            || receipt.get("job_id") != owner.get("job_id")
+            || owner.get("input_sha256").and_then(Value::as_str) != Some(input)
+            || report.get("input_sha256").and_then(Value::as_str) != Some(input)
+            || receipt.get("input_sha256").and_then(Value::as_str) != Some(input)
+            || receipt.get("solver_sha256") != owner.get("solver_sha256")
+            || receipt.get("artifact").and_then(Value::as_str) != Some(artifact)
+        {
+            return Err(bad(CMD, "saved checkpoint identity or receipt changed"));
+        }
+        let size = receipt.get("artifact_bytes").and_then(Value::as_u64).ok_or_else(|| bad(CMD, "checkpoint size is missing"))?;
+        if receipt.get("artifact_sha256").and_then(Value::as_str) != Some(&artifact_hash(&folder.join(artifact), size)?) {
+            return Err(bad(CMD, "saved checkpoint artifact changed"));
+        }
+        Ok(())
+    }
+
+    impl Owned {
+        fn report(&mut self) -> Result<Value> {
+            let report = read(&self.directory.join("job/status.json"))?;
+            let owner = read(&self.directory.join("job/job.json"))?;
+            let id = report.get("job_id").and_then(Value::as_str).filter(|s| !s.is_empty() && s.len() <= 128);
+            let state = report.get("state").and_then(Value::as_str).unwrap_or_default();
+            if report.get("schema").and_then(Value::as_str) != Some(if self.cooperative { "soil-fem-native-job-status/2" } else { "soil-fem-native-job-status/1" })
+                || owner.get("schema").and_then(Value::as_str) != Some(if self.cooperative { "soil-fem-native-job/2" } else { "soil-fem-native-job/1" })
+                || id.is_none()
+                || report.get("job_id") != owner.get("job_id")
+                || self.worker_id.as_deref().is_some_and(|known| Some(known) != id)
+                || report.get("input_sha256").and_then(Value::as_str) != Some(&self.input)
+                || owner.get("input_sha256").and_then(Value::as_str) != Some(&self.input)
+                // Windows venv launchers may own another Python process. Bind reports
+                // with the launch token, while liveness always comes from Child.
+                || report.get("host_token").and_then(Value::as_str) != Some(&self.token)
+                || owner.get("host_token").and_then(Value::as_str) != Some(&self.token)
+                || !(matches!(state, "preparing" | "running" | "cancelling" | "cancelled" | "succeeded" | "failed") || (self.cooperative && state == "checkpointed"))
+            {
+                return Err(bad(CMD, "worker status does not match this owned job"));
+            }
+            self.worker_id = id.map(str::to_string);
+            Ok(report)
+        }
+
+        fn completed_result(&self, report: &Value) -> Result<String> {
+            const RESULT: &str = "workflow/view/view-manifest.json";
+            if report.get("result").and_then(Value::as_str) != Some(RESULT) {
+                return Err(bad(CMD, "worker did not publish the expected result"));
+            }
+            let folder = self.directory.join("job");
+            let path = folder.join(RESULT);
+            let audit_path = folder.join("workflow/view-verification.json");
+            let manifest = read(&path)?;
+            let owner = read(&folder.join("job.json"))?;
+            let audit = read(&audit_path)?;
+            let digest = hash(&path)?;
+            let solver = owner.get("solver_sha256").and_then(Value::as_str).filter(|s| s.len() == 64 && s.bytes().all(|b| b.is_ascii_hexdigit()));
+            if manifest.get("schema").and_then(Value::as_str) != Some(self.view_schema)
+                || solver.is_none()
+                || manifest.get("complete") != Some(&Value::Bool(true))
+                || manifest.get("input_sha256").and_then(Value::as_str) != Some(&self.input)
+                || manifest.get("solver_binary_sha256") != owner.get("solver_sha256")
+                || report.get("result_sha256").and_then(Value::as_str) != Some(&digest)
+                || audit.get("passed") != Some(&Value::Bool(true))
+                || audit.get("input_sha256").and_then(Value::as_str) != Some(&self.input)
+                || audit.get("view_manifest_sha256").and_then(Value::as_str) != Some(&digest)
+                || report.get("view_audit_sha256").and_then(Value::as_str) != Some(&hash(&audit_path)?)
+            {
+                return Err(bad(CMD, "result, audit or input version differs from the owned job"));
+            }
+            Ok(path.to_string_lossy().into_owned())
+        }
+
+        pub(super) fn observe(&mut self) -> Result<Value> {
+            let exit = self.child.try_wait().map_err(|e| bad(CMD, e.to_string()))?;
+            let alive = exit.is_none();
+            let code = exit.and_then(|e| e.code());
+            let report_path = self.directory.join("job/status.json");
+            let awaiting_first_report = alive
+                && solidcraft_io::vfs::check(&report_path.to_string_lossy()).is_ok()
+                && std::fs::metadata(&report_path).is_err_and(|e| e.kind() == std::io::ErrorKind::NotFound);
+            let observed = if awaiting_first_report { Ok(Value::Null) } else { self.report() };
+            let (report, mut observation_error) = match observed {
+                Ok(value) => (value, None),
+                Err(error) => (Value::Null, Some(error.to_string())),
+            };
+            let mut result = None;
+            let state = if alive {
+                if self.cancelled { "cancelling" } else { "running" }
+            } else if code == Some(0) && report.get("state").and_then(Value::as_str) == Some("succeeded") {
+                match self.completed_result(&report) {
+                    Ok(path) => {
+                        result = Some(path);
+                        "succeeded"
+                    }
+                    Err(error) => {
+                        observation_error = Some(error.to_string());
+                        "failed"
+                    }
+                }
+            } else if code == Some(2) && report.get("state").and_then(Value::as_str) == Some("cancelled") {
+                "cancelled"
+            } else if self.cooperative && code == Some(3) {
+                match saved_checkpoint(&self.directory.join("job"), &self.input, &report) {
+                    Ok(()) => "checkpointed",
+                    Err(error) => {
+                        observation_error = Some(error.to_string());
+                        "failed"
+                    }
+                }
+            } else {
+                "failed"
+            };
+            Ok(json!({"job":self.token,"directory":self.directory,"input_sha256":self.input,"state":state,
+                "process_alive":alive,"process_exit_code":code,"worker_report":report,"observation_error":observation_error,
+                "cancel_requested":self.cancelled,"result":result,
+                "resume_available":state == "checkpointed",
+                "stop_policy":if self.cooperative { "cooperative_staged_checkpoint" } else { "process_stop_without_new_checkpoint" }}))
+        }
+    }
+
+    #[derive(Default)]
+    pub(crate) struct Jobs {
+        host: Option<Host>,
+        job: Option<Owned>,
+        serial: u64,
+    }
+
+    impl Jobs {
+        pub(super) fn host(&self) -> Option<&Host> {
+            self.host.as_ref()
+        }
+
+        pub(super) fn busy(&mut self) -> Result<bool> {
+            self.job.as_mut().map(|j| j.child.try_wait().map(|s| s.is_none()).map_err(|e| bad(CMD, e.to_string()))).unwrap_or(Ok(false))
+        }
+
+        pub(super) fn start(&mut self, host: Host, request: &Start, input: String, view_schema: &'static str) -> Result<()> {
+            self.launch(host, Path::new(&request.directory), input, Some(request), None, view_schema)
+        }
+
+        pub(super) fn resume(&mut self, host: Host, directory: &Path, previous: &Path, input: String, view_schema: &'static str) -> Result<()> {
+            self.launch(host, directory, input, None, Some(previous), view_schema)
+        }
+
+        fn launch(
+            &mut self,
+            host: Host,
+            directory: &Path,
+            input: String,
+            request: Option<&Start>,
+            previous: Option<&Path>,
+            view_schema: &'static str,
+        ) -> Result<()> {
+            let directory = external_path(directory)?;
+            let log_path = directory.join("host-worker.log");
+            let log = OpenOptions::new().write(true).create_new(true).open(&log_path).map_err(|e| bad(CMD, e.to_string()))?;
+            let serial = self.serial.checked_add(1).ok_or_else(|| bad(CMD, "job counter exhausted"))?;
+            let token = identity(serial)?;
+            let mut command = Command::new(&host.python);
+            command.arg(&host.worker);
+            if let Some(request) = request {
+                command.arg("run").arg(directory.join("capture")).arg(directory.join("job")).args([
+                    "--mesh-size-m",
+                    &request.mesh_size_m.to_string(),
+                    "--order",
+                    &request.element_order.to_string(),
+                    "--quadrature",
+                    &request.quadrature_order.to_string(),
+                ]);
+                if request.cooperative {
+                    command.arg("--cooperative");
+                }
+            } else if let Some(previous) = previous {
+                command.arg("resume").arg(previous.join("job")).arg(directory.join("job"));
+            } else {
+                return Err(bad(CMD, "missing job launch request"));
+            }
+            if let Some(solver) = &host.solver {
+                command.arg("--solver").arg(solver);
+            }
+            command
+                .args(["--expected-input-sha256", &input, "--watch-stdin", "--host-token", &token])
+                .current_dir(&host.root)
+                .env("PYTHONUTF8", "1")
+                .stdin(Stdio::piped())
+                .stderr(log.try_clone().map_err(|e| bad(CMD, e.to_string()))?)
+                .stdout(log);
+            #[cfg(windows)]
+            {
+                use std::os::windows::process::CommandExt;
+                command.creation_flags(0x08000000); // CREATE_NO_WINDOW
+            }
+            let child = command.spawn().map_err(|e| bad(CMD, format!("could not start FEM worker: {e}")))?;
+            self.serial = serial;
+            self.job = Some(Owned {
+                child,
+                directory,
+                input,
+                view_schema,
+                token,
+                worker_id: None,
+                cancelled: false,
+                cooperative: request.is_none_or(|r| r.cooperative),
+            });
+            Ok(())
+        }
+
+        pub(super) fn status(&mut self) -> Result<Value> {
+            let mut value = match self.job.as_mut() {
+                Some(j) => j.observe()?,
+                None => json!({"state":"idle"}),
+            };
+            value["host_available"] = json!(self.host.is_some());
+            value["host_root"] = json!(self.host.as_ref().map(|h| h.root.to_string_lossy().into_owned()));
+            Ok(value)
+        }
+
+        pub(super) fn cancel(&mut self, token: &str) -> Result<()> {
+            let job = self.job.as_mut().filter(|j| j.token == token).ok_or_else(|| bad(CMD, "unknown job in this document session"))?;
+            if job.child.try_wait().map_err(|e| bad(CMD, e.to_string()))?.is_none() {
+                job.cancelled = true;
+                job.child.stdin.take();
+            }
+            Ok(())
+        }
+    }
+
+    impl Session {
+        /// Override a program only through native host configuration, never a design or command.
+        pub fn set_soil_job_solver(&mut self, solver: &Path) -> Result<()> {
+            if self.soil_jobs.busy()? {
+                return Err(bad(CMD, "cannot replace an active FEM solver"));
+            }
+            let solver = external_path(solver)?;
+            if !solver.is_file() {
+                return Err(bad(CMD, "FEM solver must be an installed file"));
+            }
+            let host = self.soil_jobs.host.as_mut().ok_or_else(|| bad(CMD, "configure the FEM host before its solver"))?;
+            host.solver = Some(solver);
+            Ok(())
+        }
+        /// Install only from explicit native host configuration, never design metadata.
+        pub fn set_soil_job_root(&mut self, root: &Path) -> Result<()> {
+            if self.soil_jobs.busy()? {
+                return Err(bad(CMD, "cannot replace an active FEM host"));
+            }
+            self.soil_jobs.host = Some(Host::new(root)?);
+            Ok(())
+        }
+    }
