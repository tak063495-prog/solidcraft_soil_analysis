+            assert!(v["observation_error"].as_str().unwrap().contains("owned job"));
+            assert!(s.execute("analysis.soil.job.cancel", &json!({"job":"foreign"})).is_err());
+            let v = s.execute("analysis.soil.job.cancel", &json!({"job":"owned-token"})).unwrap();
+            assert_eq!(v["cancel_requested"], true);
+            finish(&mut s);
+            let v = s.execute("analysis.soil.job.status", &json!({})).unwrap();
