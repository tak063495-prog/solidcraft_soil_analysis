+pub fn start(s: &mut Session, params: &Value) -> Result<Value> {
+    let request: Start = serde_json::from_value(params.clone()).map_err(|e| bad(CMD, e.to_string()))?;
+    if request.directory.is_empty()
+        || request.directory.len() > 4096
+        || !request.mesh_size_m.is_finite()
+        || request.mesh_size_m <= 0.
+        || !matches!(request.element_order, 1 | 2)
+        || !matches!(request.quadrature_order, 3..=5)
+    {
+        return Err(bad(CMD, "invalid output directory or mesh settings"));
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        let host = s
+            .soil_jobs
+            .host()
+            .cloned()
+            .ok_or_else(|| bad(CMD, "FEM host is unavailable; set SOLIDCRAFT_SOIL_FEM_ROOT before starting the native app"))?;
+        if s.soil_jobs.busy()? {
+            return Err(bad(CMD, "an FEM job is already running in this session"));
+        }
+        let frozen = crate::soil_fem::snapshot(s, &Value::Null)?;
+        if frozen.get("input_sha256").and_then(Value::as_str) != Some(&request.expected_input_sha256) {
+            return Err(bad(CMD, "analysis inputs changed before job start"));
+        }
+        let view_schema = expected_view_schema(&frozen)?;
+        if view_schema == "soil-fem-solidcraft-view/2" && request.element_order != 2 {
+            return Err(bad(CMD, "projected MCC requires Tet10 (element order 2)"));
+        }
+        solidcraft_io::vfs::check(&request.directory).map_err(|e| bad(CMD, e.to_string()))?;
+        std::fs::create_dir(&request.directory).map_err(|e| bad(CMD, format!("new job folder required: {e}")))?;
+        let capture = std::path::Path::new(&request.directory).join("capture");
+        crate::soil_fem::export(s, &json!({"directory":capture,"expected_input_sha256":request.expected_input_sha256}))?;
+        s.soil_jobs.start(host, &request, request.expected_input_sha256.clone(), view_schema)?;
+        status(s, &json!({}))
+    }
+    #[cfg(target_arch = "wasm32")]
+    {
+        let _ = (s, request.expected_input_sha256);
+        Err(bad(CMD, "external FEM jobs require the native desktop application"))
+    }
+}
+
+pub fn status(s: &mut Session, params: &Value) -> Result<Value> {
+    if params.as_object().is_none_or(|p| !p.is_empty()) {
+        return Err(bad(CMD, "status takes an empty object"));
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        let mut value = s.soil_jobs.status()?;
+        if let Some(input) = value.get("input_sha256").and_then(Value::as_str).map(str::to_string) {
+            let current = crate::soil_fem::snapshot(s, &Value::Null);
+            let sha = current.as_ref().ok().and_then(|v| v.get("input_sha256")).and_then(Value::as_str);
+            let stale = sha != Some(&input);
+            value["current_input_sha256"] = json!(sha);
+            value["stale"] = json!(stale);
+            value["result_usable"] = json!(!stale && value.get("state").and_then(Value::as_str) == Some("succeeded"));
+            value["resume_usable"] = json!(!stale && value.get("resume_available") == Some(&Value::Bool(true)));
+            value["current_input_error"] = json!(current.err().map(|e| e.to_string()));
+        }
+        Ok(value)
+    }
+    #[cfg(target_arch = "wasm32")]
+    {
+        let _ = s;
+        Ok(json!({"state":"unavailable","host_available":false}))
+    }
+}
+
+pub fn resume(s: &mut Session, params: &Value) -> Result<Value> {
+    let request: Resume = serde_json::from_value(params.clone()).map_err(|e| bad(CMD, e.to_string()))?;
+    if request.directory.is_empty()
+        || request.directory.len() > 4096
+        || request.previous_directory.is_empty()
+        || request.previous_directory.len() > 4096
+    {
+        return Err(bad(CMD, "new output and saved job folders are required"));
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        let host = s.soil_jobs.host().cloned().ok_or_else(|| bad(CMD, "FEM host is unavailable"))?;
+        if s.soil_jobs.busy()? {
+            return Err(bad(CMD, "an FEM job is already running in this session"));
+        }
+        let frozen = crate::soil_fem::snapshot(s, &Value::Null)?;
+        if frozen.get("input_sha256").and_then(Value::as_str) != Some(&request.expected_input_sha256) {
+            return Err(bad(CMD, "analysis inputs changed before job resume"));
+        }
+        let view_schema = expected_view_schema(&frozen)?;
+        solidcraft_io::vfs::check(&request.previous_directory).map_err(|e| bad(CMD, e.to_string()))?;
+        let previous = std::path::Path::new(&request.previous_directory);
+        let saved = previous.join("job");
+        let report = native::read(&saved.join("status.json"))?;
+        native::saved_checkpoint(&saved, &request.expected_input_sha256, &report)?;
+        solidcraft_io::vfs::check(&request.directory).map_err(|e| bad(CMD, e.to_string()))?;
+        std::fs::create_dir(&request.directory).map_err(|e| bad(CMD, format!("new resume folder required: {e}")))?;
+        s.soil_jobs.resume(host, std::path::Path::new(&request.directory), previous, request.expected_input_sha256, view_schema)?;
+        status(s, &json!({}))
+    }
+    #[cfg(target_arch = "wasm32")]
+    {
+        let _ = (s, request.expected_input_sha256);
+        Err(bad(CMD, "external FEM jobs require the native desktop application"))
+    }
+}
+
+pub fn cancel(s: &mut Session, params: &Value) -> Result<Value> {
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Cancel {
+        job: String,
+    }
+    let request: Cancel = serde_json::from_value(params.clone()).map_err(|e| bad(CMD, e.to_string()))?;
+    if request.job.is_empty() || request.job.len() > 128 {
+        return Err(bad(CMD, "invalid job identity"));
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        s.soil_jobs.cancel(&request.job)?;
+        status(s, &json!({}))
+    }
+    #[cfg(target_arch = "wasm32")]
+    {
+        let _ = s;
+        Err(bad(CMD, "external FEM jobs require the native desktop application"))
+    }
+}
