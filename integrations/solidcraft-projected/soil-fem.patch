 impl Tokens {
+    /// Scientific scalar ramp derived from the current analysis palette, including
+    /// colour-vision modes. No independent caller palette or hard-coded colours.
+    pub(crate) fn analysis_scalar_color(self, fraction: f64) -> Color32 {
+        let colors = self.analysis.curvature;
+        let t = fraction.clamp(0., 1.) * 2.;
+        let (a, b, k) = if t <= 1. { (colors[0], colors[1], t) } else { (colors[1], colors[2], t - 1.) };
+        let rgb = std::array::from_fn::<_, 3, _>(|i| ((f64::from(a[i]) * (1. - k) + f64::from(b[i]) * k) * 255.).round().clamp(0., 255.) as u8);
+        Color32::from_rgb(rgb[0], rgb[1], rgb[2])
+    }
+
     /// Subtle shell elevation, derived from the semantic application-bar colour.
     pub(crate) fn shell_shadow(self) -> egui::Shadow {
         egui::Shadow { offset: [0, self.space_2 as i8], blur: self.space_8 as u8, spread: 0, color: self.app_bar.gamma_multiply(0.18) }
