{
  "schema": "soil-fem-stages/1",
  "settings": {
    "kinematics": "explicit",
    "relative_force_tolerance": 1e-08,
    "relative_linear_tolerance": 1e-10,
    "maximum_newton_iterations": 60,
    "initial_increment": 0.25,
    "minimum_increment": 0.001953125,
    "material_maximum_substep": 0.001,
    "tangent_perturbation": 1e-07,
    "maximum_free_dofs": 100000,
    "linear_solver": {
      "method": "sparse_gmres_ilu0",
      "options": {
        "restart": 60,
        "maximum_iterations": 3000,
        "pivot_tolerance": 1e-14
      }
    }
  },
  "monitors": {},
  "monitor_sets": {
    "top": "top",
    "lower_face": "Seam:a"
  },
  "pressure_on_original_surface_only": true,
  "stages": [
    {
      "kind": "boundary",
      "name": "load",
      "target_factor": 1.0,
      "initial_increment": 0.5
    },
    {
      "kind": "boundary",
      "name": "unload",
      "target_factor": 0.0,
      "initial_increment": 0.5
    },
    {
      "kind": "excavate",
      "name": "excavate_upper",
      "bodies": [
        "UpperClay"
      ],
      "remaining_surface_pressure_kpa": 0.0,
      "initial_increment": 0.5
    }
  ],
  "verification_reject_once_stages": [
    "load",
    "excavate_upper"
  ],
  "joint_system": {
    "schema": "soil-fem-joints/1",
    "geometric_tolerance_m": 1e-10,
    "maximum_increment_m": 0.0005,
    "tangent_step_m": 1e-08,
    "joints": [
      {
        "id": "Seam",
        "side_a": "Seam:a",
        "side_b": "Seam:b",
        "material": {
          "normal_stiffness_kpa_m": 1000000.0,
          "tangential_stiffness_kpa_m": 200000.0,
          "friction_coefficient": 0.3
        }
      }
    ]
  },
  "boundary": {
    "constraints": [
      {
        "node_set": "bottom",
        "direction": [
          1.0,
          0.0,
          0.0
        ],
        "value_m": 0.0
      },
      {
        "node_set": "bottom",
        "direction": [
          0.0,
          1.0,
          0.0
        ],
        "value_m": 0.0
      },
      {
        "node_set": "bottom",
        "direction": [
          0.0,
          0.0,
          1.0
        ],
        "value_m": 0.0
      }
    ],
    "surface_loads": [
      {
        "kind": "traction",
        "face_set": "top",
        "traction_kpa": [
          0.0,
          0.0,
          -5.0
        ]
      }
    ]
  }
}
