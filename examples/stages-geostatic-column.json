{
  "schema": "soil-fem-stages/1",
  "settings": {
    "kinematics": "explicit",
    "relative_force_tolerance": 1e-08,
    "relative_linear_tolerance": 1e-10,
    "maximum_newton_iterations": 35,
    "initial_increment": 1.0,
    "minimum_increment": 0.001953125,
    "material_maximum_substep": 0.001,
    "tangent_perturbation": 1e-07,
    "maximum_free_dofs": 100000,
    "linear_solver": {
      "method": "sparse_gmres_ilu0",
      "options": {
        "restart": 60,
        "maximum_iterations": 3000,
        "pivot_tolerance": 1e-14
      }
    }
  },
  "boundary": {
    "constraints": [
      {
        "node_set": "all",
        "direction": [
          1.0,
          0.0,
          0.0
        ],
        "value_m": 0.0
      },
      {
        "node_set": "all",
        "direction": [
          0.0,
          1.0,
          0.0
        ],
        "value_m": 0.0
      },
      {
        "node_set": "bottom",
        "direction": [
          0.0,
          0.0,
          1.0
        ],
        "value_m": 0.0
      }
    ]
  },
  "monitors": {
    "top": 8.0
  },
  "monitor_sets": {
    "surface": "top"
  },
  "pressure_on_original_surface_only": true,
  "stages": [
    {
      "kind": "pressure",
      "name": "small_reload",
      "target_pressure_kpa": 1.0
    },
    {
      "kind": "pressure",
      "name": "small_unload",
      "target_pressure_kpa": 0.0
    }
  ],
  "verification_reject_once_stages": []
}