{
  "schema": "soil-fem-stages/1",
  "settings": {
    "kinematics": "side_rollers",
    "relative_force_tolerance": 1e-08,
    "relative_linear_tolerance": 1e-10,
    "maximum_newton_iterations": 35,
    "initial_increment": 0.25,
    "minimum_increment": 0.001953125,
    "material_maximum_substep": 0.001,
    "tangent_perturbation": 1e-07,
    "maximum_free_dofs": 100000,
    "linear_solver": {
      "method": "sparse_gmres_ilu0",
      "options": {
        "restart": 60,
        "maximum_iterations": 3000,
        "pivot_tolerance": 1e-14
      }
    }
  },
  "monitors": {},
  "monitor_sets": {
    "pile_head": "body:Pile:zmax",
    "pile_tip": "body:Pile:zmin",
    "soil_surface": "body:Soil:zmax"
  },
  "pressure_on_original_surface_only": true,
  "stages": [
    {
      "kind": "boundary",
      "name": "load_pile",
      "target_factor": 1.0
    },
    {
      "kind": "boundary",
      "name": "unload_pile",
      "target_factor": 0.0
    }
  ],
  "boundary": {
    "constraints": [],
    "nodal_loads": [],
    "surface_loads": [
      {
        "kind": "traction",
        "face_set": "body:Pile:zmax",
        "traction_kpa": [
          10.0,
          0.0,
          -100.0
        ]
      }
    ]
  },
  "verification_reject_once_stages": [
    "load_pile",
    "unload_pile"
  ]
}