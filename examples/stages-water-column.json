{
  "schema": "soil-fem-stages/1",
  "settings": {
    "kinematics": "oedometer",
    "relative_force_tolerance": 1e-08,
    "relative_linear_tolerance": 1e-10,
    "maximum_newton_iterations": 40,
    "initial_increment": 0.5,
    "minimum_increment": 0.001953125,
    "material_maximum_substep": 0.0002,
    "tangent_perturbation": 1e-07,
    "maximum_free_dofs": 100000,
    "linear_solver": {
      "method": "sparse_gmres_ilu0",
      "options": {
        "restart": 60,
        "maximum_iterations": 3000,
        "pivot_tolerance": 1e-14
      }
    }
  },
  "monitors": {
    "top": 1.0,
    "floor": 0.5
  },
  "monitor_sets": {},
  "pressure_on_original_surface_only": false,
  "stages": [
    {
      "kind": "hydrostatic_water",
      "name": "drawdown",
      "target_level_m": 0.37,
      "initial_increment": 0.5
    },
    {
      "kind": "hydrostatic_water",
      "name": "flood",
      "target_level_m": 1.3,
      "initial_increment": 0.5
    },
    {
      "kind": "hydrostatic_water",
      "name": "drain",
      "target_level_m": -0.2,
      "initial_increment": 0.5
    },
    {
      "kind": "hydrostatic_water",
      "name": "recover",
      "target_level_m": 1.0,
      "initial_increment": 0.5
    },
    {
      "kind": "excavate",
      "name": "excavate_upper",
      "bodies": [
        "UpperClay"
      ],
      "remaining_surface_pressure_kpa": 100.0,
      "initial_increment": 0.5
    }
  ],
  "verification_reject_once_stages": [
    "drawdown",
    "excavate_upper"
  ]
}